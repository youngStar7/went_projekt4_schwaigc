<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>article</key>

    <view>articles/article</view>
    <controller>Sulu\Bundle\HeadlessBundle\Controller\HeadlessWebsiteController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title lang="en">Product</title>
        <title lang="de">Produkt</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="en">Title</title>
                <title lang="de">Titel</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>

            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="route" mandatory="true">
            <meta>
                <title lang="en">Resourcelocator</title>
                <title lang="de">Adresse</title>
            </meta>

            <tag name="sulu.rlp"/>
        </property>

        <property name="price" type="number">
            <meta>
                <title lang="en">Price</title>
                <title lang="de">Preis</title>
                <info_text lang="en">Price in EUR, e.g. 19.99</info_text>
                <info_text lang="de">Preis in EUR, z. B. 19.99</info_text>
            </meta>
            <params>
                <param name="step" value="0.01"/>
                <param name="min" value="0"/>
            </params>
        </property>

        <property name="category" type="single_category_selection">
            <meta>
                <title lang="en">Category</title>
                <title lang="de">Kategorie</title>
            </meta>
        </property>

        <property name="image" type="single_media_selection">
            <meta>
                <title lang="en">Image</title>
                <title lang="de">Bild</title>
            </meta>
            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="description" type="text_area">
            <meta>
                <title lang="en">Description</title>
                <title lang="de">Beschreibung</title>
            </meta>
        </property>

        <property name="article" type="text_editor">
            <meta>
                <title lang="en">Details</title>
                <title lang="de">Details</title>
            </meta>
        </property>
    </properties>
</template>
